{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "profiles": {
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5066",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Jwt__Key": "super-secret-key-minimum-32-characters-long",
        "Jwt__Issuer": "UrlShortener",
        "Jwt__Audience": "UrlShortener",
        "Jwt__ExpiryDays": "7"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "https://localhost:7150;http://localhost:5066",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "Jwt__Key": "super-secret-key-minimum-32-characters-long",
        "Jwt__Issuer": "UrlShortener",
        "Jwt__Audience": "UrlShortener",
        "Jwt__ExpiryDays": "7"
      }
    }
  }
}